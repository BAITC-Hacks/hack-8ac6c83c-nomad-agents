# Optional local overrides for the B00 API host.
# The host starts without Firestore or OpenAI credentials.
CORS_ORIGINS=http://localhost:5173
ASPNETCORE_URLS=http://localhost:8080
API_HOST_PORT=8080
FIRESTORE_HOST_PORT=8081
WEB_HOST_PORT=5173

# Later Firestore work uses localhost:8081 from the host machine;
# Compose sets FIRESTORE_EMULATOR_HOST=firestore:8080 inside its API container.
# FIRESTORE_EMULATOR_HOST=localhost:8081

# --- Frontend (WEB) ---
VITE_API_BASE_URL=http://localhost:8080
